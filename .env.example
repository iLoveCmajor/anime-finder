OPENAI_API_KEY=sk-...

# Optional: if set, gates the app/dashboard behind a shared password.
# Leave unset for local dev (no gate). Set this when deploying publicly.
APP_PASSWORD=

# Optional, ingest only: a Hugging Face token raises Hub rate limits for
# ingest.py's card fetch. The app itself never calls the Hub.
# HF_TOKEN=

# Optional: where the sidebar's "Monitoring" link points (default http://localhost:8502).
# DASHBOARD_URL=
